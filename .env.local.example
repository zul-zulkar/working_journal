# ─────────────────────────────────────────────────────────────────────────────
# Jurnal Kegiatan — server-only environment variables.
# Copy this file to `.env.local` and fill in real values. NEVER commit .env.local.
# The service-account credential is used only on the server (API routes / server
# components) and is never sent to the client.
# ─────────────────────────────────────────────────────────────────────────────

# Google Sheets spreadsheet id (the long id in the sheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit )
GOOGLE_SHEET_ID=

# Google Drive folder id where evidence images are stored. Create a folder in your
# own Drive and share it (Editor) with the service-account email below, then paste
# the folder id here (from the folder URL: .../folders/<THIS_PART>).
GOOGLE_DRIVE_FOLDER_ID=

# ── Service-account credentials — provide ONE of the two options ──────────────

# Option A (recommended): the whole service-account JSON on one line, OR its
# base64 encoding. On Vercel, base64 avoids newline/quoting problems:
#   base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B: the two fields separately. Keep the literal \n escapes in the key
# (they are converted to real newlines at runtime):
# GOOGLE_CLIENT_EMAIL=jurnal@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
