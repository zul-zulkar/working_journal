# ─────────────────────────────────────────────────────────────────────────────
# Jurnal Kegiatan — server-only environment variables.
# Copy this file to `.env.local` and fill in real values. NEVER commit .env.local.
# All credentials here are used only on the server (API routes / server
# components) and are never sent to the client.
# ─────────────────────────────────────────────────────────────────────────────

# Google Sheets spreadsheet id (the long id in the sheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit )
GOOGLE_SHEET_ID=

# ── Service-account credentials (Google Sheets) — provide ONE of the two ─────

# Option A (recommended): the whole service-account JSON on one line, OR its
# base64 encoding. On Vercel, base64 avoids newline/quoting problems:
#   base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B: the two fields separately. Keep the literal \n escapes in the key
# (they are converted to real newlines at runtime):
# GOOGLE_CLIENT_EMAIL=jurnal@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── Evidence images: Vercel Blob (recommended) ───────────────────────────────
# Create a Blob store in the Vercel dashboard (project → Storage → Blob) and
# connect it to this project. On Vercel the token is injected automatically;
# for local dev run `vercel env pull .env.local` or copy the token manually
# from Storage → Blob → “.env.local” snippet.
BLOB_READ_WRITE_TOKEN=

# ── LEGACY fallback: Google Drive uploads ────────────────────────────────────
# Only needed if BLOB_READ_WRITE_TOKEN is empty (uploads then go to Drive) or
# if old activities still reference Drive fileIds (read via /api/image/[id]).
#
# Drive folder id for evidence images (from the folder URL: .../folders/<ID>).
GOOGLE_DRIVE_FOLDER_ID=
#
# Service accounts have zero storage quota, so Drive uploads need OAuth as your
# own Google account (see README “Lampiran: fallback Google Drive”):
#   1. In Google Cloud Console, create an OAuth Client ID (type: Web application)
#      and add http://localhost:53682 as an Authorized redirect URI.
#   2. Fill GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET below.
#   3. Run: npm run get-drive-token   and paste the printed refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ── Share links (/share/[token]) ─────────────────────────────────────────────
# Secret used to HMAC-sign share tokens so the date range encoded in a link
# cannot be edited by the recipient to see activities outside what was shared.
# Required for the "Bagikan" feature. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value on Vercel (Project → Settings → Environment Variables) —
# changing it later invalidates all previously issued share links.
SHARE_TOKEN_SECRET=
